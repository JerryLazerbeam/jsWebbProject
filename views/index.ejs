<!DOCTYPE html>
<html lang="sv">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/output.css">
</head>

<body>
    <header>
        <h1>Product Manager</h1>
    </header>
    <main>
        <h2>Produktadministration</h2>

        <form action="/api/products" method="POST">

            <label for="namn">Produktnamn</label>
            <input type="text" id="name" name="name" class="form-input" required>

            <label for="price">Pris</label>
            <input type="number" id="price" name="price" class="form-input" required>

            <label for="SKU" class="block mb-2 font-semibold">SKU</label>
            <input type="text" id="SKU" name="SKU" pattern="[A-Z]{3}-[0-9]{3}" placeholder="ABC-123"
                title="SKU måste bestå av tre stora bokstäver följt av ett bindestreck och tre siffror."
                class="form-input" required>

            <label for="category" class="block mb-2 font-semibold">Kategori</label>
            <select name="category" id="category" class="form-input" required>
                <option value="" disabled selected hidden>Välj kategori</option>
            </select>

            <label for="description" class="block mb-2 font-semibold">
                Beskrivning
            </label>
            <textarea id="description" name="description" class="form-input h-32" required></textarea>

            <div>
                <input type="text" id="search" placeholder="Sök produkter...">

                <button id="add-product">Lägg till produkt</button>
            </div>
        </form>

        <table>
            <thead>
                <tr>
                    <th>Produkt</th>
                    <th>SKU</th>
                    <th>Pris</th>
                    <th>Åtgärder</th>
                </tr>
            </thead>

            <tbody id="product-list">
                <!-- Produkterna läggs till med JavaScript -->
            </tbody>
        </table>

        </div>
    </main>
    <script src="/js/product.js" defer>
    </script>

</body>
</html>